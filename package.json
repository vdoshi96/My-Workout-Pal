{
  "name": "my-workout-pal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Equipment-aware workout planning and interruption-safe tracking.",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:authenticated": "node scripts/test-e2e-authenticated.mjs",
    "test:e2e:release": "node scripts/test-e2e-release.mjs",
    "pwa:build": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/render-service-worker.mjs",
    "pwa:check": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/render-service-worker.mjs --check",
    "account:reconcile": "node --env-file-if-exists=.env.local --import tsx scripts/account-deletion-reconcile.ts",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/db-migrate.ts",
    "db:seed": "node --env-file-if-exists=.env.local --import tsx scripts/db-seed.ts",
    "db:verify": "node --env-file-if-exists=.env.local --import tsx scripts/db-verify.ts",
    "youtube:curate": "node --env-file-if-exists=.env.local --import tsx scripts/youtube-curate.ts",
    "youtube:import-browser": "node --env-file-if-exists=.env.local --import tsx scripts/youtube-import-browser.ts",
    "youtube:review": "node --import tsx scripts/youtube-review.ts",
    "youtube:probe-embed": "node --import tsx scripts/youtube-probe-embed.ts",
    "youtube:record-embed-verification": "node --import tsx scripts/youtube-record-embed-verification.ts",
    "youtube:generate-seed": "node --import tsx scripts/youtube-generate-seed.ts",
    "seed:check": "node --import tsx scripts/seed-check.ts",
    "docs:build": "node scripts/render-docs.mjs",
    "docs:check": "node scripts/render-docs.mjs --check",
    "db:check": "drizzle-kit check && vitest run tests/unit/database-schema.test.ts tests/integration/account-deletion-schema.test.ts tests/integration/program-collection-schema.test.ts tests/integration/starter-database-bootstrap.test.ts",
    "production:check": "node scripts/check-production-boundary.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm db:check && pnpm seed:check && pnpm pwa:check && pnpm docs:check && pnpm build && pnpm production:check",
    "verify:release": "pnpm verify && pnpm test:e2e:release"
  },
  "dependencies": {
    "@fontsource-variable/source-sans-3": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "@neondatabase/serverless": "^1.1.0",
    "drizzle-orm": "^0.45.2",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.3.0",
    "idb": "^8.0.3",
    "next": "^16.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.5.7",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitest/coverage-v8": "^4.1.11",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.2",
    "marked": "^18.0.11",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.12",
    "typescript": "^6.0.2",
    "vitest": "^4.1.11"
  }
}
